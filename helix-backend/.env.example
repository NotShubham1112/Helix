# ============================================================
# HELIX Backend Environment Configuration
# Copy this file to .env and fill in your actual values
# ============================================================

# ============== Server Configuration ==============
ENVIRONMENT=development
DEBUG=true
LOG_LEVEL=INFO
HOST=0.0.0.0
PORT=8000

# ============== Authentication ==============
# Supabase JWT Secret (from Supabase Dashboard > Settings > API)
SUPABASE_JWT_SECRET=your-supabase-jwt-secret-key-here
JWT_ALGORITHM=HS256
JWT_EXPIRATION_HOURS=24

# ============== Database ==============
# Supabase Configuration
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-supabase-anon-key
SUPABASE_ADMIN_KEY=your-supabase-service-role-key

# PostgreSQL (optional, if using direct connection)
DATABASE_URL=postgresql://user:password@localhost:5432/helix

# ============== Ollama (Local LLM) ==============
# Ollama server address
OLLAMA_URL=http://localhost:11434
OLLAMA_API_ENDPOINT=http://localhost:11434/api/generate

# Available models in Ollama
# - gemma:4b (gemma4:e2b): Primary for report generation
# - nemotron:4b (nemotron-3-nano:4b): For routing/classification
OLLAMA_PRIMARY_MODEL=gemma:4b
OLLAMA_ROUTING_MODEL=nemotron:4b

# Ollama inference settings
OLLAMA_TEMPERATURE=0.3
OLLAMA_TIMEOUT=120
OLLAMA_STREAM=false

# ============== LLM APIs (Fallback) ==============
# OpenAI API (fallback if Ollama unavailable)
OPENAI_API_KEY=sk-your-openai-key-here
OPENAI_MODEL=gpt-3.5-turbo

# OpenRouter API (alternative fallback)
OPENROUTER_API_KEY=sk-or-your-openrouter-key-here

# ============== Vector Database ==============
# FAISS local storage directory
FAISS_INDEX_DIR=./faiss_indices

# Sentence Transformers model (for embeddings)
EMBEDDING_MODEL=all-MiniLM-L6-v2

# ============== OCR Configuration ==============
# OCR provider (placeholder | tesseract | google_cloud | azure)
OCR_PROVIDER=placeholder
OCR_API_KEY=your-ocr-api-key

# ============== Storage ==============
# Supabase Storage Bucket
STORAGE_BUCKET=reports
STORAGE_MAX_FILE_SIZE=52428800

# ============== CORS ==============
CORS_ORIGINS=http://localhost:3000,http://localhost:8080,http://localhost:5173
CORS_CREDENTIALS=true
CORS_METHODS=GET,POST,PUT,DELETE,OPTIONS
CORS_HEADERS=*

# ============== Security ==============
# Rate limiting
RATE_LIMIT_ENABLED=true
RATE_LIMIT_PER_MINUTE=60

# HTTPS
HTTPS_ONLY=false
SSL_CERT_PATH=
SSL_KEY_PATH=

# ============== Monitoring & Logging ==============
# Sentry (error tracking)
SENTRY_DSN=

# Application Insights (Azure)
APPLICATIONINSIGHTS_CONNECTION_STRING=

# ============== Feature Flags ==============
FEATURE_RAG_ENABLED=true
FEATURE_VECTOR_MEMORY_ENABLED=true
FEATURE_CHAT_ENABLED=true
FEATURE_REPORT_EXPORT_ENABLED=true

# ============== Healthcare Settings ==============
# HIPAA Compliance
HIPAA_MODE=true
ENCRYPT_PII=true
DATA_RETENTION_DAYS=2555

# Clinical Settings
CONFIDENCE_THRESHOLD=0.7
MAX_REPORT_AGE_DAYS=365
ALLOW_MULTIPLE_UPLOADS=true
